{
  "meta": {
    "version": "1.0.0",
    "updated": "2026-10-15",
    "rule": "API-001 / API-002（DESIGN-API-002 §4 五要素登记制）",
    "ssot": "docs/10_规范/DESIGN-API/[DESIGN-API-002] 外部错误信封与版本弃用政策.md",
    "task": "DESIGN-ARCH-190 §五 P1-0",
    "purpose": "对客端点清单。DESIGN-ARCH-190 称其为「后续所有工作的估算基数与守卫误报率的分母」——没有它无法估算工期，也无法判断守卫该按什么口径报警。",
    "notes": [
      "本表只登记**对客面**（第三方拿标准 SDK 能调，或客户用自己的账号能调）。管理面（/api/admin、/api/ai-gateway-admin 等）不属对客契约，按 DESIGN-API-002 §1 的内外部边界另行治理。",
      "每条端点带五要素：version / request+response 字段 / auth / errorCodes / migration。缺任一要素的端点不得新增（DESIGN-API-002 §4「先登记后实现」）。",
      "status=missing 表示该能力在文档中被承诺过但代码里没有端点承载。这不是 bug，是尚未实现的阶段；它们是 P3 的输入。",
      "端点 errorCodes 一栏填的是 DESIGN-API-002 §2 已登记的 SCREAMING_SNAKE 码；细粒度区分在 details（scope / reason）。P1-1 已把历史上先用了 14 个蛇形码的问题闭合——见 errorCodeRegistry.mapping。"
    ]
  },

  "errorCodeRegistry": {
    "mappingStatus": "resolved-at-P1-1",
    "namingRule": "code 一律 SCREAMING_SNAKE 且必须先入 DESIGN-API-002 §2 表；细粒度区分进 details（scope / reason），不进 code。",
    "declaredInDesign": [
      { "code": "RATE_LIMITED", "trigger": "上游 429 / 本地限流" },
      { "code": "UNAUTHORIZED", "trigger": "401" },
      { "code": "FORBIDDEN", "trigger": "403" },
      { "code": "MODEL_NOT_FOUND", "trigger": "404/模型不存在" },
      { "code": "CONTEXT_TOO_LONG", "trigger": "413/超长" },
      { "code": "CREDITS_EXHAUSTED", "trigger": "额度不足" },
      { "code": "UPSTREAM_ERROR", "trigger": "上游 5xx" },
      { "code": "TIMEOUT", "trigger": "请求超时" },
      { "code": "NETWORK_ERROR", "trigger": "连接失败" },
      { "code": "OUTPUT_TRUNCATED", "trigger": "输出截断" },
      { "code": "CONTENT_BLOCKED", "trigger": "安全拦截" },
      { "code": "INTERNAL", "trigger": "未分类服务端错误" },
