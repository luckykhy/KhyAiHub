      "id": "amoo-tool-contract",
      "title": "Amoo / 手机桥工具名与风险契约（纯数据投影）",
      "ssot": {
        "path": "runtime/node/backend/src/services/domain/network/amoo/amooToolContract.json",
        "kind": "json-count",
        "pointer": "/tools"
