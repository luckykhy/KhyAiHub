# khy-os Docker 部署环境变量模板
#
# 用法：cp .env.example .env && docker compose up -d --build
#
# 全部变量都有合理默认值，**不改也能起来**。只有 JWT_SECRET 在生产环境必须覆盖。
# 本文件由 docker-compose.yml 读取；变量名与默认值以 docker-compose.yml 为准。

# ── 端口映射（宿主端口）────────────────────────────────────────────────────
# 容器内端口固定为 3000（后端）/ 9090（ai-backend）/ 80（前端），不可配置：
# 端口漂移会让编排层把流量转到空端口。这里只能改宿主侧。
KHY_HTTP_PORT=13000
KHY_AI_PORT=19090
KHY_WEB_PORT=8080

# ── 安全 ───────────────────────────────────────────────────────────────────
# 生产环境务必覆盖。生成：openssl rand -hex 32
JWT_SECRET=change_this_in_production

# ── 运行配置 ───────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── AI 供应商凭据（按需填，留空即该能力不可用）─────────────────────────────
# 留空不会回落成占位 key —— 未配置的供应商直接不可用，避免「看起来配好了」的假象。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 镜像名（可选）──────────────────────────────────────────────────────────
# 与 docker-compose.yml 里的默认值一致。想改用预构建镜像时改这里，
# 并把 docker-compose.yml 对应服务的 build 段删掉。
KHY_IMAGE=khy-os:local
KHY_AI_IMAGE=khy-ai-backend:local
KHY_WEB_IMAGE=khy-ai-frontend:local

# ── 关于依赖来源（PROCESS-013）─────────────────────────────────────────────
# 本项目的构建链路**一律使用官方源**，不提供镜像源开关：
#   pip  → pypi.org            npm → registry.npmjs.org
#   apt  → deb.debian.org      node → deb.nodesource.com
# 因此构建速度取决于你的网络。若你在国内且网络受限，请在**构建机**上自行配置
# 代理（HTTP_PROXY / HTTPS_PROXY 或 Docker daemon 的 registry-mirrors），
# 而不是把镜像地址写进仓库文件 —— 后者会让产物不可复现。
