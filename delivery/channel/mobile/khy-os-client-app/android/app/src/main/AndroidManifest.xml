<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Android 14+ 的 specialUse 前台服务类型。桥服务除了 dataSync（数据同步）
         之外，还承担"保活无障碍连接"这一条不属于任何既有类型的职责，因此补一个
         specialUse：它让系统在后台管控时把这份前台服务按"有正当用途"对待，
         而不是当成可随手清理的后台应用。
         配套的运行时权限是普通权限（安装即授予），但**必须**在清单里声明，
         否则 startForeground() 在 Android 14+ 上直接抛 SecurityException。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <!-- khy-os 桥（原 StepBridge 并入本 App）：文件信箱与 /sdcard 工作区需要
         所有文件访问；悬浮框需要 SYSTEM_ALERT_WINDOW；开机自启需要 BOOT。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
<!-- 锁屏冻结自解冻泵用：白名单应用自动获得，运行时仍按 canScheduleExactAlarms 降级。 -->
<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 实测 StepOS 相机在收到裸 IMAGE_CAPTURE 时校验调用方的 CAMERA 权限，
         缺它就 SecurityException（revoked permission）——即使照片由相机 App
         拍、写盘靠 EXTRA_OUTPUT。GRANTS 里有对应的一条，setup 会代授。 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>

    <queries>
        <intent><action android:name="android.intent.action.MAIN" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
    </queries>

    <application
        android:label="khy-os"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 系统分享菜单入口。
                 这是唯一让「任意已安装助手」在没被 khy-os 驱动时也能看见
                 khy-os 的通道——分享菜单在系统侧，不依赖任何助手配合。
                 进来的文字会开一个新对话，而那个对话的系统提示里带着
                 projectProfile 的优先级声明，所以走这条路送进来的内容
                 天然落在「先想 khy-os」的上下文里。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>

        <!-- 「选中文字后」菜单入口。
             默认 android:enabled="false"，由设置里的开关经
             setComponentEnabledSetting 打开。为什么默认关：它出现在**每一次**
             长按选字的菜单里，那是永久且用户可见的侵入——用一块 manifest 换来，
             所以决定权给用户，不给我们。
             用 alias 而不是直接给 MainActivity 加 filter 再在运行期摘：关掉时
             alias 整个不存在，连 manifest 层面的入口都没有，不会留一个会被
             点到却什么都不做的死项。 -->
        <activity-alias
            android:name=".ProcessTextEntry"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/process_text_entry_label">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity-alias>

        <!-- Accessibility Service for UI automation (tap/swipe/find elements) -->
        <service
            android:name=".KhyAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

        <!-- Screen Capture foreground service -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>

        <!-- khy-os 桥：HTTP(8896) + 文件信箱 + 自愈心跳。前台服务（dataSync），
             随 App 启动（BootReceiver 也拉）。

             Android 14+ 追加 specialUse：桥除了数据同步，还挂着无障碍保活这条
             职责（无障碍服务被系统省电策略冻结时，靠它保持进程与事件通道）。
             这件事不属于 mediaPlayback / dataSync 等任何既有类型，只能用
             specialUse 表达。specialUse 在 14+ 需要
             FOREGROUND_SERVICE_SPECIAL_USE 权限（上面已声明），并要求给出
             PROPERTY_SPECIAL_USE_FGS_SUBTYPE 说明用途——那个 property 是给
             应用商店审核看的，本 App 侧载分发，但仍然写清楚，免得将来上架时
             被打回。 -->
        <service
            android:name=".bridge.BridgeService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keeps the accessibility service connected while the screen is off"/>
        </service>

        <!-- 断点五：代理型 VPN。只把系统 HTTP 代理指到 127.0.0.1 的本机代理，
             不建 TUN 数据面（见 NetVpnService 的类注释）。BIND_VPN_SERVICE 是
             系统对 VpnService 的硬要求：没有它，establish() 永远返回 null。 -->
        <service
            android:name=".bridge.NetVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
        </service>

        <!-- 微信 bot 通道的保活壳（dataSync）：只 hold 进程，ilink 长轮询跑在
             Dart 侧。权限复用桥已声明的 FOREGROUND_SERVICE(_DATA_SYNC) /
             POST_NOTIFICATIONS / WAKE_LOCK，不新增。 -->
        <service
            android:name=".WeChatBotService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- 桥工作期间的悬浮框（SYSTEM_ALERT_WINDOW）。无授权时自己不画。 -->
        <service
            android:name=".bridge.BridgeOverlayService"
            android:exported="false"/>

        <!-- 任务悬浮胶囊（SYSTEM_ALERT_WINDOW，权限已在上方声明，不新增）。
             数据走文件：读 <docs>/floating/task_state.json、写 inbox.jsonl，
             不开新通道。无授权时 onCreate 直接 stopSelf，不影响其它服务。 -->
        <service
            android:name=".bridge.TaskStatusOverlayService"
            android:exported="false"/>

        <!-- L4 提示词输入页（[DESIGN-ARCH-208] 期 3，方案 B）。
             悬浮窗保持 FLAG_NOT_FOCUSABLE，输入在 App 内完成；不导出，只允许
             本 App 从悬浮窗拉起。主题用系统现成的，不新增 res。stateVisible
             让输入法随页面一起弹出，这正是「点输入就能打字」的意思。 -->
        <activity
            android:name=".bridge.PromptInputActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize|stateVisible"/>

        <!-- 桥的能力以 Android 16 AppFunction 暴露给系统助手。
             为什么值得单开一条入口：桥原有的三条（HTTP 8896 / 反代循环 / 文件信箱）
             都要点别的东西陪着——HTTP 要同主机 PC，反代循环要目标助手全程前台
             （实测约 6 分钟），信箱要轮询。AppFunction 是第一条三者都不需要的：
             系统索引声明，助手的能力路由器直接调进来。

             exported=true 是机制要求（绑定方是系统/其它进程），权限由
             BIND_APP_FUNCTION_SERVICE 收口——只有系统能绑。真正的调用方白名单在
             KhyAppFunctions.ALLOWED_CALLERS，那里同时记日志，因为「谁在调」
             只能从日志里发现。

             tools:targetApi="36" 是给 lint 的：本类继承 API 36 的
             AppFunctionService，而本 App minSdk 24。旧系统上这个类根本不会被
             实例化（没有系统去绑它），所以运行时安全；标注出来是为了让
             NewApi 警告有的放矢，而不是被全局忽略。

             元数据两份（legacy + v2）与 assets 下的 xml 对应，形状照本机第一方
             应用的惯例；一致性由 KhyAppFunctionsTest 对着 EXPOSED 表钉住。 -->
        <service
            android:name=".bridge.KhyAppFunctions"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions"
                android:value="app_functions.xml"/>
            <!--
                EXPERIMENT (2026-10-28), reversible: does declaring the schema make
                the indexer carry `description`?

                Observed on this device: our 11 functions enter the AppSearch index
                with only four static-metadata fields (enabledByDefault / functionId /
                mobileApplicationQualifiedId / packageName) and NO description, even
                though app_functions_v2.xml carries a full one per function. The three
                first-party providers that DO have descriptions in the same dump
                (AppStore / Camera / CommonAbility) all declare this property AND ship
                the androidx.appfunctions toolchain; we declare neither.

                So this is one variable, changed alone. If descriptions appear in
                `dumpsys app_function` after reinstall, the schema property is the
                gate; if they do not, the androidx service class is required and this
                line comes out. Either way the answer is worth one rebuild.

                The xsd is the AOSP original (Apache-2.0, header intact), md5
                19481529cfb779efc7c479ef16dd90f5 — identical to the copy shipped
                inside com.stepos.appstore.
            -->
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd"/>
            <property
                android:name="android.app.appfunctions.v2"
                android:value="app_functions_v2.xml"/>
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService"/>
            </intent-filter>
        </service>

        <!-- PC 侧 khy phone revive 的唤醒入口（导出广播）。 -->
        <receiver
            android:name=".bridge.ReviveReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.khyos.khy_os_client.bridge.REVIVE"/>
            </intent-filter>
        </receiver>

        <!-- 开机 / 应用更新后自启桥。 -->
        <receiver
            android:name=".bridge.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- 锁屏冻结的自解冻泵：精确闹钟到点解冻进程，worker/重连循环自己跑。
             不导出（只有系统 AlarmManager 和自己发这条）。 -->
        <receiver
            android:name=".bridge.DeviceThawReceiver"
            android:exported="false"
            android:enabled="true"/>

        <!-- 配对码的通知栏内联回复入口。
             为什么在通知栏收码：配对端点只在「使用配对码配对设备」弹窗存续期间
             存在，而一切回 App 设置页就被 stop、弹窗关闭、服务从 mDNS 消失
             （实测 2026-11-18）。通知栏只让设置页 pause，弹窗活着——所以收码
             位置必须在通知栏。不导出：这条广播只由本应用的通知发起。 -->
        <receiver
            android:name=".bridge.PairingCodeReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.khyos.khy_os_client.PAIRING_CODE"/>
            </intent-filter>
        </receiver>

        <!-- FileProvider: lets khyos hand a bundled APK to the system
             installer without exposing a file:// URI (which is blocked on
             Android 7+). Used to hand a local file to another app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Delivery canary stamp. The placeholder is merged into the binary
             manifest as a LITERAL value — aapt2 keeps meta-data
             android:value="@string/..." un-inlined as a bare resource id, so a
             resource reference here would weaken the forensic record. Read
             back with aapt2 dump xmltree after any release build. -->
        <meta-data
            android:name="khy.build"
            android:value="${khyCanary}" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
